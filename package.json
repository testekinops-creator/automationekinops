{
  "name": "myconnect-rma-automation",
  "version": "1.0.0",
  "description": "Playwright TDD Automation Framework for MyConnect RMA Module — POM, Multi-Role RBAC, CI/CD",
  "main": "playwright.config.js",
  "author": "QA Engineering Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "npx playwright test --project=rma",
    "test:all": "npx playwright test --project=rma --reporter=html",
    "test:smoke": "npx playwright test --project=rma --grep @smoke",
    "test:security": "npx playwright test --project=rma --grep @security",
    "test:auth": "npx playwright test --project=rma tests/rma/auth.spec.js",
    "test:rbac": "npx playwright test --project=rma tests/rma/rbac.spec.js",
    "test:dashboard": "npx playwright test --project=rma tests/rma/dashboard.spec.js",
    "test:submit": "npx playwright test --project=rma tests/rma/submit-rma.spec.js --grep 'Submit RMA'",
    "test:factory-receive": "npx playwright test --project=rma tests/rma/submit-rma.spec.js --grep 'Factory Receive'",
    "test:factory-insert": "npx playwright test --project=rma tests/rma/view-rma.spec.js --grep 'Factory Insert'",
    "test:view": "npx playwright test --project=rma tests/rma/view-rma.spec.js --grep 'View RMA'",
    "test:workflow": "npx playwright test --project=rma tests/rma/workflow.spec.js --grep 'Workflow'",
    "test:colors": "npx playwright test --project=rma tests/rma/workflow.spec.js --grep 'Status Badge'",
    "test:firefox": "npx playwright test --project=rma-firefox",
    "test:webkit": "npx playwright test --project=rma-webkit",
    "test:mobile": "npx playwright test --project=rma-mobile",
    "test:headed": "npx playwright test --project=rma --headed",
    "test:debug": "npx playwright test --project=rma --debug",
    "test:ui": "npx playwright test --project=rma --ui",
    "report:show": "npx playwright show-report reports/html-report",
    "allure:generate": "npx allure generate allure-results -o allure-report --clean",
    "allure:open": "npx allure open allure-report",
    "lint": "npx eslint src/ tests/",
    "lint:fix": "npx eslint src/ tests/ --fix",
    "format": "npx prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"config/**/*.js\"",
    "format:check": "npx prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"config/**/*.js\"",
    "prepare": "husky install",
    "postinstall": "npx playwright install --with-deps"
  },
  "dependencies": {
    "@playwright/test": "^1.44.0",
    "allure-playwright": "^2.15.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-playwright": "^1.6.0",
    "prettier": "^3.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}

# ──────────────────────────────────────────────────
# MyConnect RMA — Environment Configuration
# Copy this file to .env and update values as needed.
# ──────────────────────────────────────────────────

# --- Environment ---
ENV=qa
NODE_ENV=test

# --- Application URLs ---
RMA_BASE_URL=https://myconnect-dev.ekinops.com

# --- Test Credentials (Primary Admin) ---
# NOTE: Do NOT use USERNAME — it is reserved on Windows.
RMA_ADMIN_EMAIL=administrator.test@rma.com
RMA_ADMIN_PASSWORD=Admin@1234567
RMA_VALID_SERIAL=S0283505

# --- Cloud Grid (optional) ---
# Options: none | lambdatest | browserstack | saucelabs
CLOUD_GRID=none

# --- CI Metadata ---
CI=false
BUILD_NUMBER=local
BRANCH_NAME=main

# ──────────────────────────────────────────────────
# MyConnect RMA — Environment Configuration
# Copy this file to .env and update values as needed.
# ──────────────────────────────────────────────────

# --- Environment ---
ENV=qa
NODE_ENV=test

# --- Application URLs ---
RMA_BASE_URL=https://myconnect-acc.ekinops.com

# --- Test Credentials ---
# IMPORTANT: Never commit real passwords. Use a secrets manager in CI.
# NOTE: Do NOT use USERNAME — it is reserved on Windows.

# Admin / Administrator
RMA_ADMIN_EMAIL=administrator.test@rma.com
RMA_ADMIN_PASSWORD=<your-admin-password>

# RMA Admin
RMA_RMA_ADMIN_EMAIL=rma.admin@rma.com
RMA_RMA_ADMIN_PASSWORD=<your-rma-admin-password>

# Repair Engineer
RMA_ENGINEER_EMAIL=rma.engineer@rma.com
RMA_ENGINEER_PASSWORD=<your-engineer-password>

# Repair Watcher
RMA_WATCHER_EMAIL=rma.watcher@rma.com
RMA_WATCHER_PASSWORD=<your-watcher-password>

# Customer One
RMA_CUSTOMER1_EMAIL=customer.testaccess@rma.com
RMA_CUSTOMER1_PASSWORD=<your-customer1-password>

# Customer Two
RMA_CUSTOMER2_EMAIL=customer.testtransport@rma.com
RMA_CUSTOMER2_PASSWORD=<your-customer2-password>

# System User
RMA_SYSTEM_EMAIL=system.user@rma.com
RMA_SYSTEM_PASSWORD=<your-system-password>

# Inactive Customer
RMA_INACTIVE_EMAIL=inactive.customer@rma.com
RMA_INACTIVE_PASSWORD=<your-inactive-password>

# Security Test Customer
RMA_SECCUSTOMER_EMAIL=customer.testaccess2@rma.com
RMA_SECCUSTOMER_PASSWORD=<your-seccustomer-password>

# --- Test Data ---
RMA_VALID_SERIAL=T1138004504037566

# --- Cloud Grid (optional) ---
# Options: none | lambdatest | browserstack | saucelabs
CLOUD_GRID=none

# --- CI Metadata ---
CI=false
BUILD_NUMBER=local
BRANCH_NAME=main
